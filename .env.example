# As variáveis são validadas por Joi no boot (src/config/env.validation.ts).
# Os comentários indicam o fallback aplicado quando a var é omitida ou vazia.

NODE_ENV=production # development | production | test (fallback: development)

#POSTGRES CONFIG
DB_HOST=postgres        # fallback: localhost
DB_PORT=5432            # fallback: 5432
POSTGRES_USER=          # fallback: postgres
POSTGRES_PASSWORD=      # fallback: postgres
POSTGRES_DB=            # fallback: mylibrary

#APP CONFIG
PORT=3000               # fallback: 3000
# Nº de proxies na frente da app (1 = nginx/traefik na frente). true = confia em todos. Vazio = desligado
TRUST_PROXY=1

#REDIS CONFIG
REDIS_PORT=6379         # fallback: 6379
REDIS_HOST=redis        # fallback: localhost
REDIS_PASSWORD=         # pode ficar vazio

#CORS CONFIG
# Origens permitidas, separadas por vírgula (fallback: http://localhost:4200)
CORS_ORIGIN=http://localhost:4200

#Express SESSION
COOKIE_NAME=mylibrarycookie # fallback: mylibrarycookie
# OBRIGATÓRIO em produção (a app não sobe sem). Em dev tem fallback inseguro — use um segredo forte.
SESSION_SECRET=
# true/false força o secure do cookie. Vazio = secure só em produção
COOKIE_SECURE=
# lax | strict | none. Vazio = lax (subdomínios funcionam com lax)
COOKIE_SAMESITE=lax

#Bcrypt
SALT=10                 # fallback: 10

# Admin inicial — usado só pelo seeder (não pelo app). Defina para criar o primeiro admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

#S3 / GARAGE CONFIG
S3_REGION=garage        # fallback: garage
S3_BUCKET=images        # fallback: images
S3_API_URL=             # endpoint da API S3; vazio = AWS padrão
S3_WEB_URL=             # URL pública das imagens
S3_KEY_ID=
S3_SECRET_KEY=
S3_PATH_STYLE=false     # true | false (fallback: false)
