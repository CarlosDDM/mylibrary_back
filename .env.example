NODE_ENV=production #development

#POSTGRES CONFIG
DB_HOST=postgres
DB_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

#APP CONFIG
PORT=3000
# Nº de proxies na frente da app (1 = nginx/traefik na frente). true = confia em todos. Vazio = desligado
TRUST_PROXY=1

#REDIS CONFIG
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_PASSWORD=

#CORS CONFIG
# Origens permitidas, separadas por vírgula
CORS_ORIGIN=http://localhost:4200

#Express SESSION
COOKIE_NAME=mylibrarycookie
SESSION_SECRET=
# true/false força o secure do cookie. Vazio = secure só em produção
COOKIE_SECURE=
# lax | strict | none. Vazio = lax (subdomínios funcionam com lax)
COOKIE_SAMESITE=lax

#Bcrypt
SALT=10

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

#S3 / GARAGE CONFIG
S3_REGION=garage
S3_BUCKET=images
S3_API_URL=
S3_WEB_URL=
S3_KEY_ID=
S3_SECRET_KEY=
S3_PATH_STYLE=false
